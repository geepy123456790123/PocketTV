<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">

        <brls:Box backgroundColor="#050608">
                <AutoTabFrame
                        id="setting/tabFrame"
                        grow="1"
                        tabBackgroundColor="#07080C"
                        tabItemActiveTextColor="#7DDCFF"
                        defaultTab="2"
                        demandMode="false"
                        sidebarWidth="0"
                        sidebarPosition="left">

                        <Tab label="@i18n/tsvitch/setting/about/tab"
                                style="inline"
                                icon="@res/svg/setting_about.svg"
                                iconActivate="@res/svg/setting_about_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">
                                        <brls:View xml="@res/xml/fragment/settings_about.xml" />
                                </brls:ScrollingFrame>
                        </Tab>
                        <Tab label="@i18n/tsvitch/setting/tools/tab"
                                style="inline"
                                icon="@res/svg/setting_tools.svg"
                                iconActivate="@res/svg/setting_tools_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                alignItems="stretch"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/tools/proxy/header"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:InputCell
                                                                id="setting/tools/proxy/input"
                                                        />


                                                </brls:Box>
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/tools/tutorial/header"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:RadioCell
                                                                id="tools/tutorial_open"
                                                                title="@i18n/tsvitch/setting/tools/tutorial/open" />

                                                        <brls:RadioCell
                                                                id="tools/tutorial_error"
                                                                title="@i18n/tsvitch/setting/tools/tutorial/error" />

                                                        <brls:RadioCell
                                                                id="tools/tutorial_font"
                                                                title="@i18n/tsvitch/setting/tools/tutorial/font" />

                                                </brls:Box>
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/tools/test/header"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:RadioCell
                                                                id="tools/network_checker"
                                                                title="@i18n/tsvitch/setting/tools/test/net" />

                                                        <brls:RadioCell
                                                                id="tools/proxy_test"
                                                                title="@i18n/tsvitch/setting/tools/test/proxy" />

                                                        <brls:RadioCell
                                                                id="tools/vibration_test"
                                                                title="@i18n/tsvitch/setting/tools/test/vibration" />

                                                </brls:Box>
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/tools/others/header"
                                                        marginBottom="0px" />

                                                <brls:RadioCell
                                                        id="tools/config_dir"
                                                        title="@i18n/tsvitch/setting/tools/others/config" />

                                                <brls:RadioCell
                                                        id="tools/release_checker" />

                                                <brls:RadioCell
                                                        id="tools/quit"
                                                        title="@i18n/hints/exit" />
                                        </brls:Box>
                                </brls:ScrollingFrame>
                        </Tab>

                        <Tab label="TV Setup"
                                style="inline"
                                icon="@res/svg/setting_tools.svg"
                                iconActivate="@res/svg/setting_tools_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        backgroundColor="#050608"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                alignItems="stretch"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom"
                                                backgroundColor="#050608">
                                                <AuroraBackground
                                                        positionType="absolute"
                                                        positionLeft="0"
                                                        positionRight="0"
                                                        positionTop="0"
                                                        positionBottom="0"
                                                        width="100%"
                                                        height="100%" />
                                                
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="PocketTV Premium"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <SelectorCell
                                                                id="setting/iptv/mode_selector"
                                                                title="TV Source" />

                                                        <!-- Premium Section -->
                                                        <brls:Box
                                                                id="setting/iptv/premium_section"
                                                                width="100%"
                                                                height="auto"
                                                                axis="column"
                                                                marginTop="20px">

                                                                <brls:Box
                                                                        width="100%"
                                                                        height="auto"
                                                                        axis="row"
                                                                        alignItems="center"
                                                                        marginBottom="18px">

                                                                        <QRImage
                                                                                width="112"
                                                                                height="112"
                                                                                cornerRadius="8"
                                                                                QRContent="https://pocket-tv.net" />

                                                                        <brls:Box
                                                                                width="auto"
                                                                                height="auto"
                                                                                grow="1"
                                                                                axis="column"
                                                                                marginLeft="20px">

                                                                                <brls:Label
                                                                                        width="auto"
                                                                                        height="auto"
                                                                                        fontSize="22"
                                                                                        textColor="#F8FAFC"
                                                                                        text="Subscribe at pocket-tv.net" />

                                                                                <brls:Label
                                                                                        width="auto"
                                                                                        height="auto"
                                                                                        marginTop="6px"
                                                                                        fontSize="16"
                                                                                        textColor="#AEB3C2"
                                                                                        text="Scan the QR code or visit pocket-tv.net on your phone to start the free trial, then enter your activation code below." />

                                                                        </brls:Box>

                                                                </brls:Box>

                                                                <brls:InputCell
                                                                        id="setting/iptv/premium_code"
                                                                        title="Premium activation code" />

                                                        </brls:Box>

                                                </brls:Box>

                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="Install"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:RadioCell
                                                                id="setting/iptv/install_forwarder"
                                                                title="Install Home Screen Forwarder" />

                                                        <brls:Label
                                                                width="auto"
                                                                height="auto"
                                                                marginLeft="20px"
                                                                marginTop="2px"
                                                                marginBottom="18px"
                                                                fontSize="15"
                                                                textColor="#AEB3C2"
                                                                text="Adds a full-application PocketTV launcher to the Switch HOME Menu. Keep PocketTV.nro at /switch/PocketTV.nro on your microSD card." />

                                                        <brls:RadioCell
                                                                id="setting/iptv/check_update"
                                                                title="Check for PocketTV Updates" />

                                                </brls:Box>

                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="Advanced setup"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <!-- M3U8 Section -->
                                                        <brls:Box
                                                                id="setting/iptv/m3u8_section"
                                                                width="100%"
                                                                height="auto"
                                                                axis="column"
                                                                marginTop="20px">

                                                                <brls:InputCell
                                                                        id="setting/tools/m3u8/input"
                                                                        title="M3U8 URL"
                                                                />

                                                                <brls:InputCell
                                                                        id="setting/tools/epg/input"
                                                                        title="XMLTV / EPG URL"
                                                                />

                                                                <SelectorCell
                                                                        id="setting/tools/m3u8/timeout" />

                                                        </brls:Box>

                                                        <!-- Xtream Section -->
                                                        <brls:Box
                                                                id="setting/iptv/xtream_section"
                                                                width="100%"
                                                                height="auto"
                                                                axis="column"
                                                                marginTop="20px">

                                                                <brls:InputCell
                                                                        id="setting/iptv/xtream_server"
                                                                        title="Server URL" />

                                                                <brls:InputCell
                                                                        id="setting/iptv/xtream_username"
                                                                        title="Username" />

                                                                <brls:InputCell
                                                                        id="setting/iptv/xtream_password"
                                                                        title="Password" />

                                                        </brls:Box>

                                                </brls:Box>

                                        </brls:Box>
                                </brls:ScrollingFrame>
                        </Tab>

                        <Tab label="@i18n/tsvitch/setting/app/playback/header"
                                style="inline"
                                icon="@res/svg/setting_play.svg"
                                iconActivate="@res/svg/setting_play_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                alignItems="stretch"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/app/playback/player"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:BooleanCell
                                                                id="setting/video/quality" />

                                                        <brls:BooleanCell
                                                                id="setting/video/hwdec" />

                                                        <SelectorCell
                                                                id="setting/video/inmemory" />

                                                </brls:Box>

                                        </brls:Box>
                                </brls:ScrollingFrame>
                        </Tab>

                        <Tab label="@i18n/tsvitch/setting/app/ui/header"
                                style="inline"
                                icon="@res/svg/setting_ui.svg"
                                iconActivate="@res/svg/setting_ui_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                alignItems="stretch"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/app/ui/window"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:BooleanCell
                                                                id="cell/fullscreen" />

                                                        <SelectorCell
                                                                id="cell/onTopMode" />

                                                        <SelectorCell
                                                                id="setting/fps" />

                                                        <SelectorCell
                                                                id="setting/ui/theme" />

                                                        <SelectorCell
                                                                id="setting/custom/theme" />

                                                        <SelectorCell
                                                                id="setting/ui/scale" />

                                                </brls:Box>
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/app/ui/bottom_bar"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <brls:BooleanCell
                                                                id="cell/showBottomBar" />

                                                        <brls:BooleanCell
                                                                id="cell/showFPS" />

                                                        <SelectorCell
                                                                id="setting/keymap" />

                                                        <brls:BooleanCell
                                                                id="setting/keymap_swap" />

                                                </brls:Box>

                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/app/others/header"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="0px">

                                                        <brls:BooleanCell
                                                                id="cell/gamepadVibration" />

                                                        <brls:BooleanCell
                                                                id="setting/opencc" />

                                                        <SelectorCell
                                                                id="setting/language" />
                                                </brls:Box>
                                        </brls:Box>
                                </brls:ScrollingFrame>
                        </Tab>

                        <Tab label="@i18n/tsvitch/setting/app/others/header"
                                style="inline"
                                icon="@res/svg/setting_others.svg"
                                iconActivate="@res/svg/setting_others_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                alignItems="stretch"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">
                                                <brls:Header
                                                        width="auto"
                                                        height="auto"
                                                        title="@i18n/tsvitch/setting/app/image/header"
                                                        marginBottom="0px" />
                                                <brls:Box
                                                        width="100%"
                                                        height="auto"
                                                        axis="column"
                                                        marginBottom="30px">

                                                        <SelectorCell
                                                                id="setting/image/texture" />

                                                        <SelectorCell
                                                                id="setting/image/threads" />

                                                </brls:Box>
                                        </brls:Box>
                                </brls:ScrollingFrame>
                        </Tab>

                        <Tab label="@i18n/tsvitch/setting/opensource/tab"
                                style="inline"
                                icon="@res/svg/setting_github.svg"
                                iconActivate="@res/svg/setting_github_active.svg"
                                fontSize="22">
                                <brls:ScrollingFrame
                                        width="auto"
                                        height="auto"
                                        marginTop="10"
                                        grow="1.0">

                                        <brls:Box
                                                width="auto"
                                                height="auto"
                                                axis="column"
                                                wireframe="false"
                                                id="setting/opensource"
                                                paddingLeft="@style/brls/tab_frame/content_padding_sides"
                                                paddingRight="@style/brls/tab_frame/content_padding_sides"
                                                paddingTop="@style/brls/tab_frame/content_padding_top_bottom"
                                                paddingBottom="@style/brls/tab_frame/content_padding_top_bottom">

                        

                                        </brls:Box>

                                </brls:ScrollingFrame>
                        </Tab>

                </AutoTabFrame>
                <ButtonClose
                        positionType="absolute"
                        positionTop="10"
                        positionRight="10" />
        </brls:Box>

</brls:AppletFrame>
