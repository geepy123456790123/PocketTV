<brls:Box
        axis="row"
        width="auto"
        marginTop="10"
        height="auto"
        backgroundColor="#050608">
        <brls:Box
                width="270"
                height="auto"
                axis="column"
                paddingLeft="10"
                paddingRight="10"
                lineColor="#2A2D35"
                lineRight="1">
                <brls:Box
                        width="100%"
                        height="80"
                        axis="row"
                        alignItems="center"
                        paddingLeft="8"
                        paddingRight="8"
                        marginTop="4">
                        <brls:Image
                                image="@res/icon/icon.png"
                                scalingType="fit"
                                cornerRadius="8"
                                width="44"
                                height="44"
                                marginRight="12"/>
                        <brls:Label
                                width="auto"
                                height="auto"
                                fontSize="22"
                                textColor="#F8FAFC"
                                text="SwitchTV"
                                singleLine="true"/>
                </brls:Box>
                <RecyclingGrid
                        width="250"
                        grow="1"
                        marginBottom="8"
                        itemHeight="50"
                        preFetchLine="2"
                        spanCount="1"
                        wireframe="false"
                        id="dynamic/up/recyclingGrid" />
        </brls:Box>
        <RecyclingGrid
                paddingLeft="20"
                paddingRight="20"
                marginTop="70"
                grow="1"
                spanCount="1"
                itemHeight="70"
                wireframe="false"
                preFetchLine="2"
                id="home/live/recyclingGrid" />


        <brls:Box
                positionType="absolute"
                positionRight="0"
                positionTop="0"
                width="520"
                height="70"
                axis="row"
                alignItems="center"
                justifyContent="flex-end"
                wireframe="false">
                <CustomButton
                        id="home/iptv-settings"
                        focusable="true"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        width="170"
                        height="35"
                        marginRight="10"
                        backgroundColor="#2A2D35"
                        paddingLeft="15"
                        cornerRadius="12">
                        <brls:Label
                                fontSize="14"
                                textColor="#F5F5F7"
                                text="M3U / EPG" />
                        <HintLabel
                                height="35"
                                positionType="absolute"
                                positionRight="15"
                                fontSize="14"
                                textColor="#F5F5F7"
                                text="+" />
                </CustomButton>
                <CustomButton
                        id="home/search"
                        focusable="true"
                        highlightCornerRadius="8"
                        hideHighlightBackground="true"
                        width="300"
                        height="35"
                        backgroundColor="#F5F5F7"
                        paddingLeft="15"
                        cornerRadius="12">
                        <brls:Label
                                fontSize="14"
                                textColor="#18191c"
                                text="@i18n/tsvitch/home/common/search" />
                        <HintLabel
                                height="35"
                                positionType="absolute"
                                positionRight="15"
                                fontSize="14"
                                textColor="#18191c"
                                text="y" />
                </CustomButton>
        </brls:Box>

</brls:Box>
