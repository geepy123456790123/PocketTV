<brls:Box
        axis="row"
        width="100%"
        height="100%"
        backgroundColor="#050608">
        <brls:Box
                width="232"
                height="100%"
                axis="column"
                paddingLeft="18"
                paddingRight="14"
                paddingTop="12"
                paddingBottom="22"
                backgroundColor="#07080C">
                <brls:Image
                        width="196"
                        height="196"
                        marginBottom="10"
                        scalingType="fit"
                        image="@res/icon/icon.png" />
                <RecyclingGrid
                        grow="1"
                        width="100%"
                        height="auto"
                        spanCount="1"
                        itemHeight="34"
                        wireframe="false"
                        preFetchLine="2"
                        id="dynamic/up/recyclingGrid" />
                <brls:Label
                        marginTop="8"
                        fontSize="11"
                        textColor="#AEB3C2"
                        id="home/live/status"
                        text="" />
        </brls:Box>

        <brls:Box
                grow="1"
                height="100%"
                        axis="column"
                        backgroundColor="#050608">
                <brls:Box
                        height="48"
                        axis="row"
                        alignItems="center"
                        paddingLeft="20"
                        paddingRight="20"
                        backgroundColor="#080A0F">
                        <brls:Label
                                width="220"
                                fontSize="14"
                                textColor="#8D96A6"
                                text="" />
                        <brls:Label
                                id="home/live/header/0"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                        <brls:Label
                                id="home/live/header/1"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                        <brls:Label
                                id="home/live/header/2"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                </brls:Box>

                <brls:Box
                        grow="1"
                        height="auto"
                        backgroundColor="#050608">
                        <AuroraBackground
                                positionType="absolute"
                                positionLeft="0"
                                positionRight="0"
                                positionTop="0"
                                positionBottom="0"
                                width="100%"
                                height="100%" />
                        <brls:Box
                                id="home/live/setup"
                                positionType="absolute"
                                positionLeft="20"
                                positionRight="20"
                                positionTop="18"
                                positionBottom="18"
                                axis="column"
                                justifyContent="center"
                                alignItems="center"
                                visibility="gone">
                                <brls:Label
                                        width="780"
                                        height="auto"
                                        fontSize="28"
                                        textColor="#F8FAFC"
                                        horizontalAlign="center"
                                        text="Set up PocketTV" />
                                <brls:Label
                                        width="820"
                                        height="auto"
                                        marginTop="8"
                                        marginBottom="24"
                                        fontSize="15"
                                        textColor="#AEB3C2"
                                        horizontalAlign="center"
                                        text="Choose how you want to watch live TV. PocketTV does not include a playlist unless you add one or sign in to a licensed service." />
                                <CustomButton
                                        id="home/live/setup/m3u"
                                        width="560"
                                        height="58"
                                        marginBottom="10"
                                        paddingLeft="20"
                                        paddingRight="20"
                                        axis="row"
                                        focusable="true"
                                        alignItems="center"
                                        backgroundColor="#20232B"
                                        cornerRadius="8">
                                        <brls:Label
                                                width="100%"
                                                fontSize="18"
                                                textColor="#F8FAFC"
                                                text="Bring your own M3U / EPG" />
                                </CustomButton>
                                <CustomButton
                                        id="home/live/setup/premium"
                                        width="560"
                                        height="58"
                                        marginBottom="10"
                                        paddingLeft="20"
                                        paddingRight="20"
                                        axis="row"
                                        focusable="true"
                                        alignItems="center"
                                        backgroundColor="#20232B"
                                        cornerRadius="8">
                                        <brls:Label
                                                width="100%"
                                                fontSize="18"
                                                textColor="#F8FAFC"
                                                text="Subscribe to PocketTV Premium" />
                                </CustomButton>
                                <CustomButton
                                        id="home/live/setup/forwarder"
                                        width="560"
                                        height="58"
                                        paddingLeft="20"
                                        paddingRight="20"
                                        axis="row"
                                        focusable="true"
                                        alignItems="center"
                                        backgroundColor="#20232B"
                                        cornerRadius="8">
                                        <brls:Label
                                                width="100%"
                                                fontSize="18"
                                                textColor="#F8FAFC"
                                                text="Add PocketTV to the Switch home screen" />
                                </CustomButton>
                        </brls:Box>
                        <RecyclingGrid
                                grow="1"
                                paddingLeft="20"
                                paddingRight="20"
                                paddingTop="4"
                                spanCount="1"
                                itemHeight="58"
                                wireframe="false"
                                preFetchLine="2"
                                id="home/live/recyclingGrid" />
                </brls:Box>
        </brls:Box>
</brls:Box>
