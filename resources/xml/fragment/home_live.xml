<brls:Box
        axis="column"
        width="auto"
        height="auto"
        backgroundColor="#050608">
        <brls:Box
                height="88"
                axis="column"
                justifyContent="center"
                paddingLeft="24"
                paddingRight="24">
                <brls:Label
                        fontSize="22"
                        textColor="#F5F5F7"
                        text="Live TV" />
                <brls:Label
                        marginTop="6"
                        fontSize="15"
                        textColor="#AEB3C2"
                        text="Press + for M3U / EPG settings, Y to search" />
        </brls:Box>
        <RecyclingGrid
                grow="1"
                paddingLeft="20"
                paddingRight="20"
                spanCount="1"
                itemHeight="70"
                wireframe="false"
                preFetchLine="2"
                id="home/live/recyclingGrid" />
        <RecyclingGrid
                width="1"
                height="1"
                spanCount="1"
                itemHeight="1"
                wireframe="false"
                id="dynamic/up/recyclingGrid" />
</brls:Box>
