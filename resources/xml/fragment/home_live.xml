<brls:Box
        axis="row"
        width="100%"
        height="100%"
        backgroundColor="#050608">
        <brls:Box
                width="216"
                height="100%"
                axis="column"
                paddingLeft="18"
                paddingRight="14"
                paddingTop="12"
                paddingBottom="22"
                backgroundColor="#07080C">
                <brls:Image
                        width="168"
                        height="168"
                        marginBottom="10"
                        scalingType="fit"
                        image="@res/icon/icon.png" />
                <RecyclingGrid
                        grow="1"
                        width="100%"
                        height="auto"
                        spanCount="1"
                        itemHeight="34"
                        wireframe="false"
                        preFetchLine="2"
                        id="dynamic/up/recyclingGrid" />
                <brls:Label
                        marginTop="8"
                        fontSize="11"
                        textColor="#AEB3C2"
                        id="home/live/status"
                        text="" />
        </brls:Box>

        <brls:Box
                grow="1"
                height="100%"
                        axis="column"
                        backgroundColor="#050608">
                <brls:Box
                        height="48"
                        axis="row"
                        alignItems="center"
                        paddingLeft="20"
                        paddingRight="20"
                        backgroundColor="#080A0F">
                        <brls:Label
                                width="220"
                                fontSize="14"
                                textColor="#8D96A6"
                                text="" />
                        <brls:Label
                                id="home/live/header/0"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                        <brls:Label
                                id="home/live/header/1"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                        <brls:Label
                                id="home/live/header/2"
                                width="247"
                                marginLeft="6"
                                fontSize="14"
                                textColor="#AEB3C2"
                                text="" />
                </brls:Box>

                <brls:Box
                        grow="1"
                        height="auto"
                        backgroundColor="#050608">
                        <AuroraBackground
                                positionType="absolute"
                                positionLeft="0"
                                positionRight="0"
                                positionTop="0"
                                positionBottom="0"
                                width="100%"
                                height="100%" />
                        <RecyclingGrid
                                grow="1"
                                paddingLeft="20"
                                paddingRight="20"
                                paddingTop="4"
                                spanCount="1"
                                itemHeight="58"
                                wireframe="false"
                                preFetchLine="2"
                                id="home/live/recyclingGrid" />
                </brls:Box>
        </brls:Box>
</brls:Box>
