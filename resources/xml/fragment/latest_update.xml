<brls:Box
        axis="column"
        marginTop="20"
        marginBottom="20"
        width="auto"
        height="500">

    <ButtonClose
            positionType="absolute"
            positionTop="-16"
            positionRight="4"/>

    <brls:ScrollingFrame
            width="auto"
            height="auto"
            focusable="true"
            grow="1.0">

        <brls:Box
                width="auto"
                height="auto"
                minHeight="500"
                axis="column"
                paddingLeft="40"
                paddingRight="40"
                paddingTop="10"
                paddingBottom="10">

            <brls:Label
                    id="latest/header"
                    width="auto"
                    height="auto"
                    fontSize="36"
                    marginTop="10"
                    marginBottom="20"/>

            <brls:Label
                    id="latest/subtitle"
                    width="auto"
                    height="auto"
                    textColor="@theme/font/grey"
                    marginBottom="10"/>
            <brls:Box
                    id="latest/top"
                    marginBottom="30"/>

            <brls:Box
                    axis="column"
                    id="latest/textbox"/>

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
