{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pockettv-signup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "ACTIVATION_CODES",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "SERVICE_NAME": "PocketTV Signup API"
  }
}
